# ---- 基础 ----
PORT=3000
# 生产环境务必替换为随机长字符串
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# ---- 存储 ----
# 不配置 DATABASE_URL 时使用进程内存（仅开发）；docker-compose 会自动注入以下两项
# DATABASE_URL=mysql://root:sanguo_root@127.0.0.1:3306/sanguo
# REDIS_URL=redis://127.0.0.1:6379
MYSQL_ROOT_PASSWORD=sanguo_root

# ---- 微信小游戏（需正式 AppID，体验版 touristappid 无法登录/支付） ----
WX_APPID=
WX_SECRET=
# 生产环境设为 false，禁止 dev_ 伪 code 登录
ALLOW_DEV_LOGIN=true

# ---- 战斗 ----
BATTLE_TTL_SEC=1200

# ---- 虚拟支付 ----
# 支付回调校验占位：正式接入后替换为微信虚拟支付签名校验
PAY_NOTIFY_TOKEN=
# 生产环境设为 false
ALLOW_MOCK_PAY=true
